{
  "name": "nothingdns-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "wrangler dev --experimental-new-config --ip 127.0.0.1 --port 3002",
    "build:cloudflare": "pnpm build && wrangler build --experimental-new-config --experimental-cf-build-output",
    "deploy:check": "pnpm build:cloudflare && cf deploy --prebuilt --dry-run",
    "deploy": "pnpm build:cloudflare && cf deploy --prebuilt",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cf": "1.0.0-beta.12",
    "typescript": "^5.9.0",
    "wrangler": "^4.148.0"
  },
  "packageManager": "pnpm@11.25.0"
}
